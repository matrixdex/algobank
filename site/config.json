    "page_javascript": "<script>\n// KNOWN EXPLOITS AND VULNERABILITIES: search, details on narrow screens, exports (acts only on that page)\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  const q = document.getElementById(\"q\"), msg = document.getElementById(\"msg\"), data = document.getElementById(\"known.jsonl\");\n  if (!q || !data) return;\n  const phone = matchMedia(\"(max-width: 600px)\"), full = q.placeholder;\n  const placeholder = () => q.placeholder = phone.matches ? q.dataset.phone : full;\n  placeholder(); phone.addEventListener(\"change\", placeholder);\n  const entries = [...document.querySelectorAll(\"table.known tbody\")];\n  function search() {\n    const term = (q.value.trim().split(/\\s+|==/)[0] || \"\").toLowerCase().replace(/[-_.]+/g, \"-\");\n    entries.forEach(t => t.hidden = term && !t.dataset.search.replace(/[-_.]+/g, \"-\").includes(term));\n    document.querySelectorAll(\"table.known\").forEach(t => t.hidden = term && !t.querySelector(\"tbody:not([hidden])\"));\n    msg.textContent = term && entries.every(t => t.hidden) ? `${q.value.trim()}: no known exploits or vulnerabilities` : \"\";\n    history.replaceState(null, \"\", term ? \"?q=\" + encodeURIComponent(q.value.trim()) : location.pathname);\n  }\n  q.value = new URLSearchParams(location.search).get(\"q\") || \"\";\n  q.addEventListener(\"input\", search); search();\n  document.querySelectorAll(\"table.known tr.entry\").forEach(tr => {\n    const toggle = () => { const d = tr.nextElementSibling; d.hidden = !d.hidden; tr.setAttribute(\"aria-expanded\", !d.hidden); };\n    tr.addEventListener(\"click\", toggle);\n    tr.addEventListener(\"keydown\", e => { if (e.key === \"Enter\" || e.key === \" \") { e.preventDefault(); toggle(); } });\n  });\n  const jsonl = data.textContent.trim() + \"\\n\";\n  function csv() {\n    const rows = jsonl.trim().split(\"\\n\").map(l => JSON.parse(l)), cols = [...new Set(rows.flatMap(Object.keys))];\n    const quote = x => { const s = Array.isArray(x) ? x.join(\", \") : String(x ?? \"\"); return /[\",\\n]/.test(s) ? '\"' + s.replace(/\"/g, '\"\"') + '\"' : s; };\n    return [cols, ...rows.map(r => cols.map(c => r[c]))].map(r => r.map(quote).join(\",\")).join(\"\\n\") + \"\\n\";\n  }\n  document.querySelectorAll(\"[data-export]\").forEach(b => b.addEventListener(\"click\", () => {\n    const type = b.dataset.export, a = document.createElement(\"a\");\n    a.href = URL.createObjectURL(new Blob([type === \"csv\" ? csv() : jsonl], { type: type === \"csv\" ? \"text/csv\" : \"application/x-ndjson\" }));\n    a.download = \"known.\" + type; a.click(); URL.revokeObjectURL(a.href);\n  }));\n});\n</script>\n",
    "index_javascript": "<script>\n// BANK SEARCH: \"package\" or \"package v1.2.3\" (also \"package 1.2.3\", \"package==1.2.3\"); ?q= in the address works too\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  const q = document.getElementById(\"q\"), msg = document.getElementById(\"msg\");\n  const phone = matchMedia(\"(max-width: 600px)\"), full = q.placeholder;   // the same width as the phone styles\n  const placeholder = () => q.placeholder = phone.matches ? q.dataset.phone : full;\n  placeholder(); phone.addEventListener(\"change\", placeholder);\n  const rows = [...document.querySelectorAll(\"#bank tbody\")];    // one tbody per record: entry and details\n  // DETAILS: click an entry (or press Enter on it) to open or close its details below it\n  document.querySelectorAll(\"#bank tr.entry\").forEach(tr => {\n    const toggle = () => { const d = tr.nextElementSibling; d.hidden = !d.hidden; tr.setAttribute(\"aria-expanded\", !d.hidden); };\n    tr.addEventListener(\"click\", toggle);\n    tr.addEventListener(\"keydown\", e => { if (e.key === \"Enter\" || e.key === \" \") { e.preventDefault(); toggle(); } });\n  });\n  // COPY: the full hash or code root behind a shortened one\n  document.querySelectorAll(\"#bank .copy\").forEach(b => b.addEventListener(\"click\", e => {\n    e.stopPropagation();\n    const done = () => { b.textContent = \"copied\"; setTimeout(() => b.textContent = \"copy\", 1500); };\n    if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(b.dataset.copy).then(done);\n    else { const t = document.createElement(\"textarea\"); t.value = b.dataset.copy; document.body.appendChild(t);\n           t.select(); document.execCommand(\"copy\"); t.remove(); done(); }\n  }));\n  const norm = s => s.toLowerCase().replace(/[-_.]+/g, \"-\");          // PEP 503 package names\n  function search() {\n    const [name = \"\", v = \"\"] = q.value.trim().split(/\\s+|==/).filter(Boolean);\n    const version = v.replace(/^v/i, \"\");\n    const n = norm(name);\n    const named = rows.filter(r => version ? norm(r.dataset.name) === n : norm(r.dataset.name).includes(n));\n    const exact = named.filter(r => r.dataset.version === version);\n    const shown = version && exact.length ? exact : named;\n    rows.forEach(r => r.hidden = !shown.includes(r));\n    msg.textContent = !name ? \"\"\n      : version && !exact.length ? `${name} v${version} are not algobanked`\n      : !named.length ? `${name} is not algobanked` : \"\";\n    history.replaceState(null, \"\", name ? \"?q=\" + encodeURIComponent(q.value.trim()) : location.pathname);\n  }\n  // EXPORT: the bank as shipped in this page, as bank.jsonl (unchanged) or bank.csv (one column per field)\n  const jsonl = document.getElementById(\"bank.jsonl\").textContent.trim() + \"\\n\";\n  function csv() {\n    const recs = jsonl.trim().split(\"\\n\").map(l => JSON.parse(l));\n    const flat = r => Object.fromEntries(Object.entries(r).flatMap(([k, v]) =>\n      Array.isArray(v) ? [[k, v.join(\", \")]] : v && typeof v === \"object\" ? Object.entries(v).map(([s, x]) => [k + \".\" + s, x]) : [[k, v]]));\n    const rows = recs.map(flat), cols = [...new Set(rows.flatMap(Object.keys))];\n    const quote = x => /[\",\\n]/.test(String(x ?? \"\")) ? '\"' + String(x).replace(/\"/g, '\"\"') + '\"' : String(x ?? \"\");\n    return [cols, ...rows.map(r => cols.map(c => r[c]))].map(r => r.map(quote).join(\",\")).join(\"\\n\") + \"\\n\";\n  }\n  document.querySelectorAll(\"[data-export]\").forEach(b => b.addEventListener(\"click\", () => {\n    const type = b.dataset.export, a = document.createElement(\"a\");\n    a.href = URL.createObjectURL(new Blob([type === \"csv\" ? csv() : jsonl], { type: type === \"csv\" ? \"text/csv\" : \"application/x-ndjson\" }));\n    a.download = \"bank.\" + type; a.click(); URL.revokeObjectURL(a.href);\n  }));\n  q.value = new URLSearchParams(location.search).get(\"q\") || \"\";\n  q.addEventListener(\"input\", search);\n  search();\n});\n</script>\n",
